//
// DO NOT MODIFY options.hpp, it is automatically generated by cmake from options.hpp.in
// Build options that change a type or a layout must be baked in here rather than passed as an
// INTERFACE compile definition, or a consumer who includes the headers without our CMake gets a
// different answer than one who does, and the two disagree about the layout of everything built
// on top of it.
//

#ifndef SZ3_OPTIONS_HPP
#define SZ3_OPTIONS_HPP

#cmakedefine01 SZ3_USE_SKA_HASH

#endif  // SZ3_OPTIONS_HPP
