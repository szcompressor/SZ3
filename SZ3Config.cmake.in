@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

include("${CMAKE_CURRENT_LIST_DIR}/SZ3Targets.cmake")

# No SZ3::zstd in the export means the build used a system Zstd.
if(NOT TARGET SZ3::zstd)
  # Found again, not taken from the export: the build machine's path need not exist here.
  find_library(SZ3_ZSTD_LIBRARY NAMES zstd)
  if(NOT SZ3_ZSTD_LIBRARY)
    set(SZ3_NOT_FOUND_MESSAGE "SZ3 was built against the system Zstd and no libzstd was found here. Install Zstd's development package, or set SZ3_ZSTD_LIBRARY.")
    set(SZ3_FOUND FALSE)
    return()
  endif()
  set_property(TARGET SZ3::SZ3 APPEND PROPERTY INTERFACE_LINK_LIBRARIES "${SZ3_ZSTD_LIBRARY}")
endif()

# The export CMake generates raises FATAL_ERROR when a file it names is gone, which would end
# the configure of a consumer that only wanted the header-only SZ3. Skip it instead: the filter is
# reached through HDF5's plugin path, so a consumer that does want it is not held up by the target.
set(_sz3_filter "${CMAKE_CURRENT_LIST_DIR}/HDF5SZ3.cmake")
if(EXISTS "${_sz3_filter}")
  set(_sz3_filter_usable TRUE)
  # Ask the export's own question off its own list, rather than guessing artifact names and
  # directories per platform: a shared Windows build records an import library AND a bin/ DLL.
  file(GLOB _sz3_filter_configs "${CMAKE_CURRENT_LIST_DIR}/HDF5SZ3-*.cmake")
  foreach(_sz3_filter_config IN LISTS _sz3_filter_configs)
    # Two spellings: CMake 3.24 renamed the variable. Matching neither leaves the export included,
    # which is no worse than before this guard existed.
    file(STRINGS "${_sz3_filter_config}" _sz3_filter_lines
         REGEX "_cmake_import_check_files_for_|_IMPORT_CHECK_FILES_FOR_")
    string(REGEX MATCHALL "\"[^\"]+\"" _sz3_filter_files "${_sz3_filter_lines}")
    foreach(_sz3_filter_file IN LISTS _sz3_filter_files)
      string(REPLACE "\"" "" _sz3_filter_file "${_sz3_filter_file}")
      string(REPLACE "\${_IMPORT_PREFIX}" "${PACKAGE_PREFIX_DIR}" _sz3_filter_file "${_sz3_filter_file}")
      if(NOT EXISTS "${_sz3_filter_file}")
        set(_sz3_filter_usable FALSE)
      endif()
    endforeach()
  endforeach()
  if(_sz3_filter_usable)
    # find_dependency, so this does not demand HDF5 on its own: a consumer who did not write
    # REQUIRED gets SZ3_FOUND FALSE and a reason, which is what GMX_USE_SZ3=AUTO needs.
    find_dependency(HDF5 COMPONENTS C)
    include("${_sz3_filter}")
  endif()
  unset(_sz3_filter_usable)
  unset(_sz3_filter_configs)
  unset(_sz3_filter_config)
  unset(_sz3_filter_lines)
  unset(_sz3_filter_files)
  unset(_sz3_filter_file)
endif()
unset(_sz3_filter)

if(@OpenMP_FOUND@)
  # SZ3 was built with OpenMP, so a consumer has to link its runtime. FindOpenMP can only produce
  # the target for a language that consumer enabled, and C and C++ share one runtime on every
  # compiler SZ3 builds under, so ask for whichever of the two is available here. A C-only consumer
  # asked for CXX instead gets "Could NOT find OpenMP (missing: OpenMP_CXX_FOUND CXX)".
  get_property(sz3_enabled_languages GLOBAL PROPERTY ENABLED_LANGUAGES)
  if("CXX" IN_LIST sz3_enabled_languages)
    find_dependency(OpenMP COMPONENTS CXX)
    set_property(TARGET SZ3::SZ3 APPEND PROPERTY INTERFACE_LINK_LIBRARIES OpenMP::OpenMP_CXX)
  elseif("C" IN_LIST sz3_enabled_languages)
    find_dependency(OpenMP COMPONENTS C)
    set_property(TARGET SZ3::SZ3 APPEND PROPERTY INTERFACE_LINK_LIBRARIES OpenMP::OpenMP_C)
  endif()
  unset(sz3_enabled_languages)
endif()

# Without these, target_link_libraries(x PRIVATE hdf5sz3) silently becomes -lhdf5sz3.
foreach(sz3_target SZ3 hdf5sz3)
  if(TARGET SZ3::${sz3_target} AND NOT TARGET ${sz3_target})
    add_library(${sz3_target} INTERFACE IMPORTED)
    target_link_libraries(${sz3_target} INTERFACE SZ3::${sz3_target})
  endif()
endforeach()
check_required_components(SZ3)
